# 复制为 .env（和 docker-compose.yml 同目录），docker compose 会自动读取。

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-to-a-random-password
POSTGRES_DB=linear

# 后端
# 一定要换成随机字符串，例如: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 浏览器访问这个应用时用的地址（协议+host+端口），只在跨域直连后端时校验用得到，
# 通过 nginx 同源反代访问时基本不会触发，但仍建议填成真实访问地址。
FRONTEND_ORIGIN=http://192.168.1.100

# 前端 nginx 对外暴露的端口
HTTP_PORT=80
